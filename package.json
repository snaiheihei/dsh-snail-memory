{
  "name": "dsh-snail-memory",
  "version": "0.1.5",
  "description": "Single-user global and workspace memory for DeepSeek Harness",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "plugin.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json && tsc -p tsconfig.test.json",
    "lint": "eslint src client/src tests scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "memory",
    "cordis-plugin"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-commands": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-workspace": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-attachment": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-brand": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.5",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-ptc-runtime": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-storage": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-storage-domain": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-timeout": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-user-approval": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-util-values": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.5",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "jsdom": "29.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "author": "snaiheihei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snaiheihei/dsh-snail-memory.git"
  },
  "bugs": {
    "url": "https://github.com/snaiheihei/dsh-snail-memory/issues"
  },
  "homepage": "https://github.com/snaiheihei/dsh-snail-memory#readme"
}
